{
  "name": "ai-4x",
  "version": "0.2.0",
  "private": true,
  "description": "Rundenbasiertes 4X-Zivilisations- und Wirtschaftsstrategiespiel",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "assets:check": "node scripts/check-assets.mjs --strict",
    "android:sync": "npm run build && cap sync android",
    "android:open": "cap open android",
    "art:render": "node scripts/render-art.mjs",
    "art:check": "node scripts/render-art.mjs --check",
    "assets:release-check": "node scripts/check-assets.mjs --release",
    "art:prune": "node scripts/prune-backlog.mjs"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.6.9",
    "@resvg/resvg-js": "^2.6.2",
    "typescript": "^5.9.3",
    "vite": "^6.4.4",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@capacitor/android": "^7.6.9",
    "@capacitor/core": "^7.6.9"
  }
}
